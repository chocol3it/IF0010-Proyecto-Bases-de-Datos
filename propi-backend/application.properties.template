spring.application.name=propi
server.port=8080

# Conexion a SQL Server local (copiar a src/main/resources/application.properties).
# propi_app es el login tecnico creado en database/11_seguridad.sql: no tiene permisos
# sobre los datos, solo puede suplantar (EXECUTE AS USER) al usuario que inicio sesion.
spring.datasource.url=jdbc:sqlserver://localhost:1433;databaseName=PropiFacturacion_AAMM;encrypt=true;trustServerCertificate=true;
spring.datasource.username=propi_app
spring.datasource.password=PropiApp#2026
spring.datasource.driver-class-name=com.microsoft.sqlserver.jdbc.SQLServerDriver

# Seguridad JWT (clave de al menos 32 caracteres; el token dura 8 horas)
app.jwt.secret=CAMBIAR_POR_UNA_CLAVE_SECRETA_DE_AL_MENOS_32_BYTES
app.jwt.expiration-ms=28800000
