  "productos_servicios.cod_producto" [shape=ellipse, label=<<U>cod_producto</U>>];
  "productos_servicios" -- "productos_servicios.cod_producto" [len=1.2];
  "productos_servicios.cod_cabys" [shape=ellipse, label="cod_cabys"];
  "productos_servicios" -- "productos_servicios.cod_cabys" [len=1.2];
  "productos_servicios.des_producto" [shape=ellipse, label="des_producto"];
  "productos_servicios" -- "productos_servicios.des_producto" [len=1.2];
  "productos_servicios.mon_precio" [shape=ellipse, label="mon_precio"];
  "productos_servicios" -- "productos_servicios.mon_precio" [len=1.2];
  "facturas" [shape=box, style="filled", fillcolor="#dbeafe", fontsize=12, label="facturas"];
  "facturas.cod_factura" [shape=ellipse, label=<<U>cod_factura</U>>];
  "facturas" -- "facturas.cod_factura" [len=1.2];
  "facturas.fec_factura" [shape=ellipse, label="fec_factura"];
  "facturas" -- "facturas.fec_factura" [len=1.2];
  "facturas.mon_tipo_cambio" [shape=ellipse, label="mon_tipo_cambio"];
  "facturas" -- "facturas.mon_tipo_cambio" [len=1.2];
  "facturas.des_observaciones" [shape=ellipse, label="des_observaciones"];
  "facturas" -- "facturas.des_observaciones" [len=1.2];
  "facturas.mon_subtotal" [shape=ellipse, style=dashed, label="mon_subtotal"];
  "facturas" -- "facturas.mon_subtotal" [len=1.2];
  "facturas.mon_total_impuestos" [shape=ellipse, style=dashed, label="mon_total_impuestos"];
  "facturas" -- "facturas.mon_total_impuestos" [len=1.2];
  "facturas.mon_total" [shape=ellipse, style=dashed, label="mon_total"];
  "facturas" -- "facturas.mon_total" [len=1.2];
  "facturas_detalle" [shape=box, style="filled", fillcolor="#dbeafe", fontsize=12, label="facturas_detalle"];
  "facturas_detalle.cod_detalle" [shape=ellipse, label=<<U>cod_detalle</U>>];
  "facturas_detalle" -- "facturas_detalle.cod_detalle" [len=1.2];
  "facturas_detalle.can_cantidad" [shape=ellipse, label="can_cantidad"];
  "facturas_detalle" -- "facturas_detalle.can_cantidad" [len=1.2];
  "facturas_detalle.mon_precio_unitario" [shape=ellipse, label="mon_precio_unitario"];
  "facturas_detalle" -- "facturas_detalle.mon_precio_unitario" [len=1.2];
  "facturas_detalle.mon_impuesto" [shape=ellipse, label="mon_impuesto"];
  "facturas_detalle" -- "facturas_detalle.mon_impuesto" [len=1.2];
  "facturas_detalle.mon_linea" [shape=ellipse, style=dashed, label="mon_linea"];
  "facturas_detalle" -- "facturas_detalle.mon_linea" [len=1.2];
  "notas_credito_debito" [shape=box, style="filled", fillcolor="#dbeafe", fontsize=12, label="notas_credito_debito"];
  "notas_credito_debito.cod_nota" [shape=ellipse, label=<<U>cod_nota</U>>];
  "notas_credito_debito" -- "notas_credito_debito.cod_nota" [len=1.2];
  "notas_credito_debito.fec_nota" [shape=ellipse, label="fec_nota"];
  "notas_credito_debito" -- "notas_credito_debito.fec_nota" [len=1.2];
  "notas_credito_debito.des_motivo" [shape=ellipse, label="des_motivo"];
  "notas_credito_debito" -- "notas_credito_debito.des_motivo" [len=1.2];
  "notas_credito_debito.mon_nota" [shape=ellipse, label="mon_nota"];
  "notas_credito_debito" -- "notas_credito_debito.mon_nota" [len=1.2];
  "r0" [shape=diamond, style="filled", fillcolor="#fef3c7", label="identifica"];
  "tipos_identificacion" -- "r0" [label="1", len=2.2];
  "r0" -- "clientes" [label="N", len=2.2];
  "r1" [shape=diamond, style="filled", fillcolor="#fef3c7", label="clasifica"];
  "estados" -- "r1" [label="1", len=2.2];
  "r1" -- "clientes" [label="N", len=2.2];
  "r2" [shape=diamond, style="filled", fillcolor="#fef3c7", label="clasifica"];
  "estados" -- "r2" [label="1", len=2.2];
  "r2" -- "tipos_impuesto" [label="N", len=2.2];
  "r3" [shape=diamond, style="filled", fillcolor="#fef3c7", label="clasifica"];
  "estados" -- "r3" [label="1", len=2.2];
  "r3" -- "productos_servicios" [label="N", len=2.2];
  "r4" [shape=diamond, style="filled", fillcolor="#fef3c7", label="recibe"];
  "clientes" -- "r4" [label="1", len=2.2];
  "r4" -- "facturas" [label="N", len=2.2];
  "r5" [shape=diamond, style="filled", fillcolor="#fef3c7", label="rige"];
  "condiciones_venta" -- "r5" [label="1", len=2.2];
  "r5" -- "facturas" [label="N", len=2.2];
  "r6" [shape=diamond, style="filled", fillcolor="#fef3c7", label="paga"];
  "medios_pago" -- "r6" [label="1", len=2.2];
  "r6" -- "facturas" [label="N", len=2.2];
  "r7" [shape=diamond, style="filled", fillcolor="#fef3c7", label="expresa"];
  "monedas" -- "r7" [label="1", len=2.2];
  "r7" -- "facturas" [label="N", len=2.2];
  "r8" [shape=diamond, style="filled", fillcolor="#fef3c7", label="contiene"];
  "facturas" -- "r8" [label="1", len=2.2];
  "r8" -- "facturas_detalle" [label="N", len=2.2];
  "r9" [shape=diamond, style="filled", fillcolor="#fef3c7", label="se vende en"];
  "productos_servicios" -- "r9" [label="1", len=2.2];
  "r9" -- "facturas_detalle" [label="N", len=2.2];
  "r10" [shape=diamond, style="filled", fillcolor="#fef3c7", label="mide"];
  "unidades_medida" -- "r10" [label="1", len=2.2];
  "r10" -- "productos_servicios" [label="N", len=2.2];
  "r11" [shape=diamond, style="filled", fillcolor="#fef3c7", label="grava"];
  "tipos_impuesto" -- "r11" [label="1", len=2.2];
  "r11" -- "productos_servicios" [label="N", len=2.2];
  "r12" [shape=diamond, style="filled", fillcolor="#fef3c7", label="se ajusta con"];
  "facturas" -- "r12" [label="1", len=2.2];
  "r12" -- "notas_credito_debito" [label="N", len=2.2];
  "r13" [shape=diamond, style="filled", fillcolor="#fef3c7", label="tipifica"];
  "tipos_nota" -- "r13" [label="1", len=2.2];
  "r13" -- "notas_credito_debito" [label="N", len=2.2];
}
