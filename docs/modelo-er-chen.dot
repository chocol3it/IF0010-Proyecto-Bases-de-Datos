// Modelo entidad-relacion (notacion de Chen) - Propi Facturacion
// Generar imagen: neato -Tpng modelo-er-chen.dot -o modelo-er-chen.png
graph chen {
  graph [overlap=false, splines=true, sep="+6", fontname="Helvetica", bgcolor="white"];
  node [fontname="Helvetica", fontsize=10];
  edge [color="#333333"];
  "clientes" [shape=box, style="filled", fillcolor="#dbeafe", fontsize=12, label="clientes"];
  "clientes.cod_cliente" [shape=ellipse, label=<<U>cod_cliente</U>>];
  "clientes" -- "clientes.cod_cliente" [len=1.2];
  "clientes.nom_cliente" [shape=ellipse, label="nom_cliente"];
  "clientes" -- "clientes.nom_cliente" [len=1.2];
  "clientes.num_identificacion" [shape=ellipse, label="num_identificacion"];
  "clientes" -- "clientes.num_identificacion" [len=1.2];
  "clientes.domicilio" [shape=ellipse, label="domicilio"];
  "clientes" -- "clientes.domicilio" [len=1.2];
  "clientes.domicilio.des_provincia" [shape=ellipse, label="des_provincia"];
  "clientes.domicilio" -- "clientes.domicilio.des_provincia" [len=1.0];
  "clientes.domicilio.des_canton" [shape=ellipse, label="des_canton"];
  "clientes.domicilio" -- "clientes.domicilio.des_canton" [len=1.0];
  "clientes.domicilio.des_distrito" [shape=ellipse, label="des_distrito"];
  "clientes.domicilio" -- "clientes.domicilio.des_distrito" [len=1.0];
  "clientes.domicilio.des_barrio" [shape=ellipse, label="des_barrio"];
  "clientes.domicilio" -- "clientes.domicilio.des_barrio" [len=1.0];
  "clientes.des_profesion" [shape=ellipse, label="des_profesion"];
  "clientes" -- "clientes.des_profesion" [len=1.2];
  "clientes.des_actividad_economica" [shape=ellipse, label="des_actividad_economica"];
  "clientes" -- "clientes.des_actividad_economica" [len=1.2];
  "clientes.des_correo" [shape=ellipse, label="des_correo"];
  "clientes" -- "clientes.des_correo" [len=1.2];
  "clientes.num_telefono" [shape=ellipse, label="num_telefono"];
  "clientes" -- "clientes.num_telefono" [len=1.2];
  "clientes.fec_registro" [shape=ellipse, label="fec_registro"];
  "clientes" -- "clientes.fec_registro" [len=1.2];
  "estados" [shape=box, style="filled", fillcolor="#dbeafe", fontsize=12, label="estados"];
  "estados.cod_estado" [shape=ellipse, label=<<U>cod_estado</U>>];
  "estados" -- "estados.cod_estado" [len=1.2];
  "estados.des_estado" [shape=ellipse, label="des_estado"];
  "estados" -- "estados.des_estado" [len=1.2];
  "tipos_identificacion" [shape=box, style="filled", fillcolor="#dbeafe", fontsize=12, label="tipos_identificacion"];
  "tipos_identificacion.cod_tipo_identificacion" [shape=ellipse, label=<<U>cod_tipo_identificacion</U>>];
  "tipos_identificacion" -- "tipos_identificacion.cod_tipo_identificacion" [len=1.2];
  "tipos_identificacion.des_tipo_identificacion" [shape=ellipse, label="des_tipo_identificacion"];
  "tipos_identificacion" -- "tipos_identificacion.des_tipo_identificacion" [len=1.2];
  "condiciones_venta" [shape=box, style="filled", fillcolor="#dbeafe", fontsize=12, label="condiciones_venta"];
  "condiciones_venta.cod_condicion_venta" [shape=ellipse, label=<<U>cod_condicion_venta</U>>];
  "condiciones_venta" -- "condiciones_venta.cod_condicion_venta" [len=1.2];
  "condiciones_venta.des_condicion_venta" [shape=ellipse, label="des_condicion_venta"];
  "condiciones_venta" -- "condiciones_venta.des_condicion_venta" [len=1.2];
  "medios_pago" [shape=box, style="filled", fillcolor="#dbeafe", fontsize=12, label="medios_pago"];
  "medios_pago.cod_medio_pago" [shape=ellipse, label=<<U>cod_medio_pago</U>>];
  "medios_pago" -- "medios_pago.cod_medio_pago" [len=1.2];
  "medios_pago.des_medio_pago" [shape=ellipse, label="des_medio_pago"];
  "medios_pago" -- "medios_pago.des_medio_pago" [len=1.2];
  "monedas" [shape=box, style="filled", fillcolor="#dbeafe", fontsize=12, label="monedas"];
  "monedas.cod_moneda" [shape=ellipse, label=<<U>cod_moneda</U>>];
  "monedas" -- "monedas.cod_moneda" [len=1.2];
  "monedas.cod_iso" [shape=ellipse, label="cod_iso"];
  "monedas" -- "monedas.cod_iso" [len=1.2];
  "monedas.des_moneda" [shape=ellipse, label="des_moneda"];
  "monedas" -- "monedas.des_moneda" [len=1.2];
  "unidades_medida" [shape=box, style="filled", fillcolor="#dbeafe", fontsize=12, label="unidades_medida"];
  "unidades_medida.cod_unidad_medida" [shape=ellipse, label=<<U>cod_unidad_medida</U>>];
  "unidades_medida" -- "unidades_medida.cod_unidad_medida" [len=1.2];
  "unidades_medida.des_unidad_medida" [shape=ellipse, label="des_unidad_medida"];
  "unidades_medida" -- "unidades_medida.des_unidad_medida" [len=1.2];
  "tipos_nota" [shape=box, style="filled", fillcolor="#dbeafe", fontsize=12, label="tipos_nota"];
  "tipos_nota.cod_tipo_nota" [shape=ellipse, label=<<U>cod_tipo_nota</U>>];
  "tipos_nota" -- "tipos_nota.cod_tipo_nota" [len=1.2];
  "tipos_nota.des_tipo_nota" [shape=ellipse, label="des_tipo_nota"];
  "tipos_nota" -- "tipos_nota.des_tipo_nota" [len=1.2];
  "tipos_impuesto" [shape=box, style="filled", fillcolor="#dbeafe", fontsize=12, label="tipos_impuesto"];
  "tipos_impuesto.cod_tipo_impuesto" [shape=ellipse, label=<<U>cod_tipo_impuesto</U>>];
  "tipos_impuesto" -- "tipos_impuesto.cod_tipo_impuesto" [len=1.2];
  "tipos_impuesto.cod_tarifa" [shape=ellipse, label="cod_tarifa"];
  "tipos_impuesto" -- "tipos_impuesto.cod_tarifa" [len=1.2];
  "tipos_impuesto.des_tipo_impuesto" [shape=ellipse, label="des_tipo_impuesto"];
  "tipos_impuesto" -- "tipos_impuesto.des_tipo_impuesto" [len=1.2];
  "tipos_impuesto.por_impuesto" [shape=ellipse, label="por_impuesto"];
  "tipos_impuesto" -- "tipos_impuesto.por_impuesto" [len=1.2];
